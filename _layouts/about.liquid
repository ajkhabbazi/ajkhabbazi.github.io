---
layout: default
---
<div class="post">
  <header class="post-header about-hero">
    {% if page.profile and page.profile.image %}
      <div class="about-hero-photo">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid z-depth-1 rounded" sizes="200px" alt="Arash Jalil Khabbazi"
          cache_bust=true
        %}
      </div>
    {% endif %}
    <div class="about-hero-name">
      <h1 class="post-title">
        {% if site.title == 'blank' %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% else %}
          {{ site.title }}
        {% endif %}
      </h1>
      <p class="desc">{{ page.subtitle }}</p>
    </div>
    {% if page.availability %}
      <div class="availability">
        <div class="availability-text">{{ page.availability | markdownify }}</div>
        <div class="availability-actions">
          <a class="availability-btn availability-btn--primary" href="{{ '/assets/pdf/resume-ajk.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-file-lines" aria-hidden="true"></i>resume</a>
        </div>
      </div>
    {% endif %}
  </header>

  <article>
    <div class="clearfix">{{ content }}</div>

    <!-- Research: the three PhD phases, each linking to its card on the research page -->
    <h2 style="margin-top: 2rem;">
      <a href="{{ '/research/' | relative_url }}" class="heading-link">Research</a>
    </h2>
    <div class="home-phases">
      <a class="home-phase home-phase--done" href="{{ '/research/' | relative_url }}#phase-1">
        <span class="home-phase-num" aria-hidden="true">1</span>
        <span class="home-phase-body">
          <span class="home-phase-title">State of the art</span>
          <span class="home-phase-text">What real buildings have shown</span>
          <span class="home-phase-status">Completed</span>
        </span>
      </a>
      <a class="home-phase" href="{{ '/research/' | relative_url }}#phase-2">
        <span class="home-phase-num" aria-hidden="true">2</span>
        <span class="home-phase-body">
          <span class="home-phase-title">Protocols</span>
          <span class="home-phase-text">Measuring savings reliably</span>
          <span class="home-phase-status">In progress</span>
        </span>
      </a>
      <a class="home-phase" href="{{ '/research/' | relative_url }}#phase-3">
        <span class="home-phase-num" aria-hidden="true">3</span>
        <span class="home-phase-body">
          <span class="home-phase-title">Deployment</span>
          <span class="home-phase-text">Control that scales</span>
          <span class="home-phase-status">In progress</span>
        </span>
      </a>
    </div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2 style="margin-top: 2rem;">
        <a href="{{ '/news/' | relative_url }}" class="heading-link">News</a>
      </h2>

      <div class="home-panel">{% include news.liquid limit=true %}</div>
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" class="heading-link">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2 style="margin-top: 2rem;">
        <a href="{{ '/publications/' | relative_url }}" class="heading-link">Select Publications</a>
      </h2>
      <div class="home-panel">{% include selected_papers.liquid %}</div>
    {% endif %}

    <!-- Social -->
    {% if page.social %}
      <div class="social">
        <div class="contact-icons">{% include social.liquid %}</div>

        <div class="contact-note">{{ site.contact_note }}</div>
      </div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
</div>
