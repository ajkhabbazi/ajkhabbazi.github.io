{% comment %}
  News feed.

  Every item in `_news/` carries a `kind` (paper / talk / award / milestone) in
  its front matter, which supplies the label text and the filter chips. All
  kinds share one neutral style defined in `_sass/_news.scss`. Adding an item
  needs no change here.

  Included with `limit=true` (the about page), only the first
  `page.announcements.limit` items are rendered, followed by a link to the news page.
  Included without `limit` (the news page), everything is shown, no button is
  rendered, and a row of per-kind filter chips is shown above the feed. There
  the list also sits on a solid panel, grouped under year headings along a
  timeline (`newsfeed--full`), so it stays readable over the site backdrop.
{% endcomment %}

{% assign news_size = site.news | size %}

<div class="newsfeed{% unless include.limit %} newsfeed--full{% endunless %}">
  {% if news_size > 0 %}
    {% assign news_items = site.news | sort: 'date' | reverse %}

    {% if include.limit and page.announcements.limit %}
      {% assign visible_count = page.announcements.limit %}
    {% else %}
      {% assign visible_count = news_size %}
    {% endif %}

    {% assign hidden_count = news_size | minus: visible_count %}
    {% if hidden_count < 0 %}
      {% assign hidden_count = 0 %}
    {% endif %}

    {% unless include.limit %}
      {% assign kinds = news_items | map: 'kind' | compact | uniq | sort %}
      {% if kinds.size > 1 %}
        <div class="newsfeed-filters" role="group" aria-label="Filter news by kind">
          <button class="newsfeed-filter newsfeed-filter--active" type="button" data-newsfeed-filter="all" aria-pressed="true">
            <span>All</span>
          </button>
          {% for kind in kinds %}
            <button
              class="newsfeed-filter"
              type="button"
              data-newsfeed-filter="{{ kind }}"
              aria-pressed="false"
            >
              {% include news_kind_icon.liquid kind=kind %}
              <span>{{ kind | capitalize }}</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
    {% endunless %}

    <ul class="newsfeed-list">
      {% assign previous_year = '' %}
      {% for item in news_items %}
        {% if forloop.index > visible_count %}
          {% break %}
        {% endif %}
        {% assign item_year = item.date | date: '%Y' %}
        {% unless include.limit %}
          {% if item_year != previous_year %}
            <li class="newsfeed-year" data-newsfeed-year="{{ item_year }}">{{ item_year }}</li>
            {% assign previous_year = item_year %}
          {% endif %}
        {% endunless %}
        <li
          class="newsfeed-entry"
          data-newsfeed-year="{{ item_year }}"
          {% if item.kind %}
            data-newsfeed-kind="{{ item.kind }}"
          {% endif %}
        >
          <div class="newsfeed-meta">
            {% if item.kind %}
              <span class="newsfeed-kind">{% include news_kind_icon.liquid kind=item.kind %}{{ item.kind }}</span>
            {% endif %}
            <time class="newsfeed-date" datetime="{{ item.date | date_to_xmlschema }}">
              {{ item.date | date: '%Y-%m-%d' }}
            </time>
          </div>
          <div class="newsfeed-body">
            {% if item.inline %}
              {{ item.content | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>

    {% if hidden_count > 0 %}
      <a class="newsfeed-more" href="{{ '/news/' | relative_url }}">See all {{ news_size }} news items</a>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>

<script>
  // Kind filters. Only rendered on the full news page, where no entry is hidden
  // by the "show earlier updates" toggle, so [hidden] here is ours alone.
  document.querySelectorAll('.newsfeed-filters').forEach(function (bar) {
    const feed = bar.closest('.newsfeed');
    if (!feed) return;

    const buttons = bar.querySelectorAll('.newsfeed-filter');
    const entries = feed.querySelectorAll('.newsfeed-entry');

    bar.addEventListener('click', function (event) {
      const button = event.target.closest('.newsfeed-filter');
      if (!button) return;

      const selected = button.dataset.newsfeedFilter;

      buttons.forEach(function (other) {
        const active = other === button;
        other.classList.toggle('newsfeed-filter--active', active);
        other.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      entries.forEach(function (entry) {
        entry.hidden = selected !== 'all' && entry.dataset.newsfeedKind !== selected;
      });

      // A year heading stays only while one of its entries is showing.
      feed.querySelectorAll('.newsfeed-year').forEach(function (heading) {
        const year = heading.dataset.newsfeedYear;
        let any = false;
        entries.forEach(function (entry) {
          if (!entry.hidden && entry.dataset.newsfeedYear === year) any = true;
        });
        heading.hidden = !any;
      });
    });
  });
</script>
