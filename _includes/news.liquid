{% comment %}
  News feed.

  Every item in `_news/` carries a `kind` (paper / talk / award / milestone) in
  its front matter, which selects the label and accent colour defined in
  `_sass/_news.scss`. Adding an item needs no change here.

  Included with `limit=true` (the about page), items past
  `page.announcements.limit` are rendered but hidden, and a button reveals them.
  Included without `limit` (the news page), everything is shown, no button is
  rendered, and a row of per-kind filter chips is shown above the feed.
{% endcomment %}

{% assign news_size = site.news | size %}

<div class="newsfeed">
  {% if news_size > 0 %}
    {% assign news_items = site.news | sort: 'date' | reverse %}

    {% if include.limit and page.announcements.limit %}
      {% assign visible_count = page.announcements.limit %}
    {% else %}
      {% assign visible_count = news_size %}
    {% endif %}

    {% assign hidden_count = news_size | minus: visible_count %}
    {% if hidden_count < 0 %}
      {% assign hidden_count = 0 %}
    {% endif %}

    {% unless include.limit %}
      {% assign kinds = news_items | map: 'kind' | compact | uniq | sort %}
      {% if kinds.size > 1 %}
        <div class="newsfeed-filters" role="group" aria-label="Filter news by kind">
          <button class="newsfeed-filter newsfeed-filter--active" type="button" data-newsfeed-filter="all" aria-pressed="true">
            <i class="fa-solid fa-layer-group" aria-hidden="true"></i>
            <span>All</span>
          </button>
          {% for kind in kinds %}
            {% capture kind_icon %}{% include news_kind_icon.liquid kind=kind %}{% endcapture %}
            <button
              class="newsfeed-filter newsfeed-filter--{{ kind }}"
              type="button"
              data-newsfeed-filter="{{ kind }}"
              aria-pressed="false"
            >
              <i class="fa-solid {{ kind_icon | strip }}" aria-hidden="true"></i>
              <span>{{ kind | capitalize }}</span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
    {% endunless %}

    <ul class="newsfeed-list">
      {% for item in news_items %}
        <li
          class="newsfeed-entry{% if item.kind %} newsfeed-entry--{{ item.kind }}{% endif %}"
          {% if item.kind %}
            data-newsfeed-kind="{{ item.kind }}"
          {% endif %}
          {% if forloop.index > visible_count %}
            data-newsfeed-extra
            hidden
          {% endif %}
        >
          <div class="newsfeed-meta">
            {% if item.kind %}
              {% capture item_icon %}{% include news_kind_icon.liquid kind=item.kind %}{% endcapture %}
              <span class="newsfeed-kind">
                <i class="fa-solid {{ item_icon | strip }}" aria-hidden="true"></i>
                {{ item.kind }}
              </span>
            {% endif %}
            <time class="newsfeed-date" datetime="{{ item.date | date_to_xmlschema }}">
              {{ item.date | date: '%Y-%m-%d' }}
            </time>
          </div>
          <div class="newsfeed-body">
            {% if item.inline %}
              {{ item.content | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>

    {% if hidden_count > 0 %}
      {% if hidden_count == 1 %}
        {% assign more_label = 'Show 1 earlier update' %}
      {% else %}
        {% assign more_label = hidden_count | prepend: 'Show ' | append: ' earlier updates' %}
      {% endif %}
      <button
        class="newsfeed-toggle"
        type="button"
        aria-expanded="false"
        data-label-more="{{ more_label }}"
        data-label-less="Show fewer"
      >
        <span class="newsfeed-toggle-label">{{ more_label }}</span>
        <span class="newsfeed-toggle-caret" aria-hidden="true">&#9662;</span>
      </button>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>

<script>
  document.querySelectorAll('.newsfeed-toggle').forEach(function (toggle) {
    const feed = toggle.closest('.newsfeed');
    if (!feed) return;

    const extras = feed.querySelectorAll('[data-newsfeed-extra]');
    const label = toggle.querySelector('.newsfeed-toggle-label');

    toggle.addEventListener('click', function () {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      extras.forEach(function (entry) {
        entry.hidden = expanded;
      });
      toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      toggle.classList.toggle('newsfeed-toggle--open', !expanded);
      label.textContent = expanded ? toggle.dataset.labelMore : toggle.dataset.labelLess;
    });
  });

  // Kind filters. Only rendered on the full news page, where no entry is hidden
  // by the "show earlier updates" toggle, so [hidden] here is ours alone.
  document.querySelectorAll('.newsfeed-filters').forEach(function (bar) {
    const feed = bar.closest('.newsfeed');
    if (!feed) return;

    const buttons = bar.querySelectorAll('.newsfeed-filter');
    const entries = feed.querySelectorAll('.newsfeed-entry');

    bar.addEventListener('click', function (event) {
      const button = event.target.closest('.newsfeed-filter');
      if (!button) return;

      const selected = button.dataset.newsfeedFilter;

      buttons.forEach(function (other) {
        const active = other === button;
        other.classList.toggle('newsfeed-filter--active', active);
        other.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      entries.forEach(function (entry) {
        entry.hidden = selected !== 'all' && entry.dataset.newsfeedKind !== selected;
      });
    });
  });
</script>
